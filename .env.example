# انسخ هذا الملف إلى .env.local محليًا، وأدخل نفس القيم في Vercel → Settings → Environment Variables

# من Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# سرّي — لا يُستخدم إلا في كود الخادم (API routes)، ولا يظهر أبدًا في المتصفح
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# رابط الموقع المنشور الفعلي (بدون / في النهاية) — يُستخدم في success_url
# وfailure_url وwebhook_endpoint لدى Chargily، وفي روابط بريد Resend، وفي
# Open Graph. يجب أن يكون رابطًا حقيقيًا وليس localhost.
# مثال أثناء الاختبار: https://crayon-planet.vercel.app
# بعد ربط النطاق: https://crayonplanetdz.com
NEXT_PUBLIC_SITE_URL=https://crayon-planet.vercel.app

# Chargily Pay — من لوحة تحكم Chargily (Sandbox أولًا، ثم Live لاحقًا)
# سرّي بالكامل، لا يوضع إلا في متغيرات البيئة على الخادم.
CHARGILY_SECRET_KEY=
# test أو live
CHARGILY_MODE=test

# Resend — لإرسال بريد تأكيد الدفع ورابط التحميل
RESEND_API_KEY=
# يجب أن يكون النطاق مُتحقَّقًا (Verified) في Resend قبل استخدامه هنا؛
# إلى أن يتم ذلك استخدم onboarding@resend.dev للاختبار فقط.
RESEND_FROM_EMAIL="CRAYON PLANET <onboarding@resend.dev>"
